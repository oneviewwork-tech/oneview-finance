generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Identity & Access ────────────────────────────────────────────────
//
// Mirrors ONEVIEW People's User/SystemRole shape (NextAuth JWT + Credentials
// provider), but this app has its own User table and its own login — see
// the Phase 0 decision to keep Finance a standalone app rather than share
// hrms's session. Roles follow the spec's "ENTITY-BASED ACCESS" section
// directly: a UAE finance user must not be able to touch India data, and a
// viewer never gets write access anywhere.

enum UserRole {
  SUPER_ADMIN // full read/write across both entities + user/master-data admin
  FINANCE_ADMIN // full read/write across both entities, not user admin
  UAE_FINANCE_USER // read/write scoped to the UAE entity only
  INDIA_FINANCE_USER // read/write scoped to the India entity only
  MANAGEMENT_VIEWER // read-only, all entities, combined dashboard included
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               UserRole  @default(MANAGEMENT_VIEWER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastActiveAt       DateTime?

  // Brute-force protection: incremented on every wrong password, reset on
  // success. Once it crosses LOCKOUT_THRESHOLD (see auth.ts), lockedUntil
  // is set and login is refused until that time passes, regardless of
  // whether the password given afterward is correct — this is deliberately
  // account-based (not just IP-based), since the account is the asset
  // being protected.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Second factor for privileged access (Super Admins, and anyone opening
  // Finance View). A separate secret from the password, asked for once per
  // login, so a stolen password alone doesn't expose financial data.
  //
  // NOTE: "passkey" here means a user-chosen secret, NOT WebAuthn/FIDO2 —
  // this is a knowledge factor, not a hardware one. Named to match what the
  // business calls it; don't mistake it for platform passkeys.
  passkeyHash           String?
  passkeySetAt          DateTime?
  passkeyFailedAttempts Int       @default(0)
  passkeyLockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTransactions FinancialTransaction[] @relation("TransactionCreatedBy")
  updatedTransactions FinancialTransaction[] @relation("TransactionUpdatedBy")
  payments            Payment[]
  exchangeRates       ExchangeRate[]
  sessions            UserSession[]
  passkeyResetTokens  PasskeyResetToken[]
  passwordResetTokens PasswordResetToken[]
  ledgerMonths        LedgerMonth[]       @relation("LedgerMonthCreatedBy")
}

/// A month of the books for one entity — the app's equivalent of one
/// workbook file ("Dubai — August 2026"), covering both trackers.
///
/// Exists as a row so a month can be opened before anything is entered in
/// it. Months are otherwise derivable from transaction dates, but a
/// freshly created empty month would then vanish on reload, and the whole
/// point is to create the month first and fill it in afterwards.
model LedgerMonth {
  id       String         @id @default(cuid())
  entityId String
  entity   BusinessEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  /// Four-digit year and 1-12 month, stored separately rather than as a date
  /// so there is no timezone in which "August" becomes July.
  year     Int
  month    Int

  createdById String
  createdBy   User     @relation("LedgerMonthCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([entityId, year, month])
  @@index([entityId, year, month])
}

/// One-time code emailed to reset a forgotten passkey.
///
/// The code is stored hashed, never in clear text: this table is as
/// sensitive as the passkey it can replace, and a DB leak shouldn't hand
/// over working reset codes. Rows are single-use (consumedAt) and short-
/// lived (expiresAt), with their own attempt counter so guessing a 6-digit
/// code is not feasible.
model PasskeyResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

/// One-time code emailed to reset a forgotten LOGIN password — separate
/// from PasskeyResetToken because this one is requested by someone who
/// isn't signed in yet. The request step must not reveal whether the
/// email address it was given belongs to a real account, so the same
/// generic response is returned whether or not a token row gets created.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

// One row per login. Lets a real logout event be recorded (vs. a JWT that
// merely expires client-side), and gives a Super Admin a real "who's
// signed in, from where" view without needing anything beyond Postgres.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt    DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  logoutAt   DateTime?
  ipAddress  String?
  userAgent  String?

  @@index([userId])
  @@index([lastSeenAt])
}

// ── Currency & FX ────────────────────────────────────────────────────
//
// Only AED and INR exist today. Modelled as an enum, not a lookup table,
// because the workbook and spec never treat currency as data with its own
// attributes (symbol/decimals are formatting concerns, handled in code) —
// adding a third currency later is a one-line enum + migration, which is
// proportionate to how rarely that happens for this business.

enum Currency {
  AED
  INR
}

enum RateSource {
  LIVE // fetched from the configured FX provider
  MANUAL // entered by a Finance Admin / FX_MANAGE user, overrides LIVE for that date
}

// One row per (base, quote, date). Reporting always resolves a rate by
// explicit date — "today's" dashboard uses today's rate, a historical
// period report uses that period's rate — never a single mutable "current
// rate" global, per the spec's FX ACCOUNTING RULE (no silent
// re-calculation of old reports against today's rate).
model ExchangeRate {
  id            String     @id @default(cuid())
  baseCurrency  Currency
  quoteCurrency Currency
  rate          Decimal    @db.Decimal(14, 6)
  rateDate      DateTime   @db.Date
  source        RateSource
  sourceDetail  String? // e.g. provider name for LIVE, free text for MANUAL
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate, source])
  @@index([baseCurrency, quoteCurrency, rateDate])
}

// ── Business entities (UAE / India) ─────────────────────────────────

enum EntityStatus {
  ACTIVE
  INACTIVE
}

model BusinessEntity {
  id           String       @id @default(cuid())
  code         String       @unique // "UAE" | "INDIA"
  name         String
  country      String
  baseCurrency Currency
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions FinancialTransaction[]
  clients      Client[]
  vendors      Vendor[]
  ledgerMonths LedgerMonth[]
}

// ── Master data (was the "Lists" sheet — now DB-backed and editable) ──

model FinancialCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]
}

// Not part of the source workbook — added so Outflow can be tagged by which
// department/team an expense belongs to (e.g. salary runs), enabling a
// per-department paid/pending status view. Optional, outflow-only; existing
// and untagged transactions simply don't appear in that breakdown.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]
}

// Payment Tracker's "Type" column: Current Month vs Old Dues / Arrears.
// Kept configurable like every other Lists-sheet column rather than a
// hardcoded enum, per the spec's "do not hardcode categories/types" rule.
model ExpenseType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model ClientType {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

// ── Clients & Vendors ────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id           String       @id @default(cuid())
  entityId     String
  entity       BusinessEntity @relation(fields: [entityId], references: [id])
  name         String
  clientTypeId String?
  clientType   ClientType?  @relation(fields: [clientTypeId], references: [id])
  status       ClientStatus @default(ACTIVE)
  country      String?
  currency     Currency?
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions FinancialTransaction[]

  @@unique([entityId, name])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

// Optional on outflow transactions — the source Payment Tracker has no
// vendor field today (just a free-text Expense Item), so this is forward
// data model support per the spec, not a field the accounts team is forced
// to fill in on day one.
model Vendor {
  id        String       @id @default(cuid())
  entityId  String
  entity    BusinessEntity @relation(fields: [entityId], references: [id])
  name      String
  country   String?
  currency  Currency?
  status    VendorStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions FinancialTransaction[]

  @@unique([entityId, name])
}

// ── Financial transactions (the unified model — no monthly tables) ───

enum TransactionType {
  INFLOW // one row per client deal/receipt (was Inflow Tracker)
  OUTFLOW // one row per expense (was Payment Tracker)
}

// Mirrors the workbook's Status formula exactly:
// paid<=0 -> PENDING, paid>=amount -> PAID, else -> PARTIAL.
enum TransactionStatus {
  PENDING
  PARTIAL
  PAID
}

model FinancialTransaction {
  id              String            @id @default(cuid())
  entityId        String
  entity          BusinessEntity    @relation(fields: [entityId], references: [id])
  transactionType TransactionType
  transactionDate DateTime          @db.Date

  // Original currency is always preserved — reporting-currency conversion
  // is a read-time projection, never written back over this value.
  //
  // originalAmount is the GROSS figure — what the client owes or the vendor
  // is owed, tax included. It has to be, because it is what payments settle
  // against and what every dashboard, receivable and export already sums;
  // making it net would understate every one of those totals the moment
  // anyone entered a tax figure. The net value is originalAmount - taxAmount.
  originalAmount   Decimal  @db.Decimal(14, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(14, 2)
  originalCurrency Currency

  // Outflow-only fields
  categoryId    String?
  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  expenseTypeId String?
  expenseType   ExpenseType?       @relation(fields: [expenseTypeId], references: [id])
  vendorId      String?
  vendor        Vendor?            @relation(fields: [vendorId], references: [id])

  // Set on BOTH directions: a department spends (outflow) and earns (inflow),
  // and tagging only its costs would make every department look like a pure
  // expense. Neither workbook sheet has this column — it's ONEVIEW-only, so
  // it stays optional and the Excel round-trip is unaffected.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Inflow-only fields
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id])
  closedByName String? // "Closed By (BD)" — free text in the source data, not a User FK

  description     String // Expense Item (outflow) / Service-Project (inflow)
  referenceNumber String?
  remarks         String?

  // paidAmount/status are a deliberate, bounded denormalization: recomputed
  // transactionally inside the same DB write whenever a Payment row changes
  // (see the Payment model), never edited directly. This is NOT the same
  // thing as the workbook's separate hand-maintained summary sheets — those
  // are fully replaced by live aggregation queries in Phase 3/4. This cache
  // exists only so a single transaction's own status can be read without a
  // join+SUM on every list row.
  paidAmount Decimal           @default(0) @db.Decimal(14, 2)
  status     TransactionStatus @default(PENDING)

  createdById String
  createdBy   User    @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("TransactionUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@index([entityId, transactionType, transactionDate])
  @@index([categoryId])
  @@index([departmentId])
  @@index([clientId])
  @@index([vendorId])
  @@index([status])
}

// Every partial/full settlement — for BOTH outflow payments and inflow
// receipts — is one row here. Paid = SUM(payments) for a transaction;
// Balance = originalAmount - Paid. This single ledger is what lets the
// spec's "multiple partial receipts against one deal" requirement work for
// inflows the same way multi-installment expense payments work for
// outflows, instead of the workbook's single "Amount Paid" cell per row.
model Payment {
  id              String        @id @default(cuid())
  transactionId   String
  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(14, 2)
  currency        Currency
  paymentDate     DateTime      @db.Date
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  referenceNumber String?
  notes           String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([transactionId])
}

// ── Audit ────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PAYMENT_RECORDED
  PAYMENT_UPDATED
  PAYMENT_REVERSED
  STATUS_CHANGED
  CATEGORY_CHANGED
  CLIENT_CHANGED
  EXPORT
  IMPORT
  FX_RATE_UPDATED
  // Identity & access — added for Phase 6.
  LOGIN
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  ACCESS_DENIED
  // Passkey second factor.
  PASSKEY_SET
  PASSKEY_VERIFIED
  PASSKEY_FAILED
  PASSKEY_LOCKED
  PASSKEY_RESET_REQUESTED
  PASSKEY_RESET_COMPLETED
  PASSKEY_CLEARED
  // Login password reset, requested while signed out.
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
}

// Append-only. actorUserId/actorEmail are deliberately plain fields, not a
// relation, the same way hrms's AuditEvent keeps actor identity even after
// the acting User row is later deleted — audit history must survive user
// deletion.
model AuditEvent {
  id           String      @id @default(cuid())
  entityType   String // model name, e.g. "FinancialTransaction"
  entityId     String
  action       AuditAction
  actorUserId  String?
  actorEmail   String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
